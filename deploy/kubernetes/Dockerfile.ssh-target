# Synthetic external destination only; no Regente binary or agent is installed.
FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
RUN apk add --no-cache openssh-server && adduser -D -u 10001 runner && passwd -d runner && mkdir -p /run/sshd /keys /data /jobs
COPY ssh-target.conf /etc/ssh/sshd_config
ENTRYPOINT ["/bin/sh", "-ec", "cp /source/host_key /keys/host_key; cp /source/authorized_keys /keys/authorized_keys; chmod 600 /keys/host_key; chmod 644 /keys/authorized_keys; chown 10001:10001 /data; exec /usr/sbin/sshd -D -e -f /etc/ssh/sshd_config"]
