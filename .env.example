# Regente server — quando setado, todo o runtime (definitions, scheduler,
# instances) roteia pelo regente-server Go. Vazio = modo local (localStorage).
#
# Suba o server e o agente em dev:
#   cd ../server && go run . -api-token dev-token
#   cd ../agent  && go run . -server ws://localhost:8080/ws/agent -token dev-token -caps COMMAND,SCRIPT,HTTP
VITE_REGENTE_SERVER_URL=http://localhost:8080
VITE_REGENTE_TOKEN=dev-token
