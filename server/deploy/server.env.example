# Config do regente-server (lida via EnvironmentFile da unit systemd).
# Copie para /etc/regente/server.env e ajuste. Todas as chaves são opcionais
# (têm default são); descomente o que precisar.

# Token de API (web + agentes). TROQUE por um valor forte.
REGENTE_TOKEN=change-me

# --- Estado ---
# sqlite (default, zero-infra) ou postgres (recomendado p/ produção/HA).
REGENTE_DB_DRIVER=sqlite
# sqlite: caminho do arquivo | postgres: DSN
REGENTE_DB=/var/lib/regente/regente.db
# Exemplo Postgres (HA + persistência fora do nó):
# REGENTE_DB_DRIVER=postgres
# REGENTE_DB=postgres://user:pw@host:5432/regente?sslmode=require

# Workspace (clone GitOps + DB sqlite quando aplicável)
REGENTE_WORKSPACE=/var/lib/regente/workspace

# Listen
REGENTE_ADDR=:8080

# --- GitOps (opcional) ---
# Fonte da verdade das definitions. Remova para rodar offline (só disco).
REGENTE_GIT_SOURCE=https://github.com/Dr0nj/regente-workspace.git
REGENTE_GIT_BRANCH=main
REGENTE_GIT_REPO=Dr0nj/regente-workspace

# Token do GitHub p/ push/PR e clone de repo privado.
# Prefira o secrets provider (não fica na DB em claro) a colar na UI:
# REGENTE_SECRET_GITHUB_TOKEN=ghp_...
# (alternativa equivalente reconhecida pelo server: GITHUB_TOKEN=ghp_...)

# --- HA (opcional, requer Postgres) ---
# Suba N instâncias com o MESMO REGENTE_DB; só o líder roda a daily/dispatch.
# REGENTE_ROLE=all
# REGENTE_SCHEDULER=internal
