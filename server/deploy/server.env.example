# Config do regente-server (lida via EnvironmentFile da unit systemd).
# Copie para /etc/regente/server.env e ajuste. Todas as chaves são opcionais
# (têm default são); descomente o que precisar.

# Token de API (web + agentes). TROQUE por um valor forte.
REGENTE_TOKEN=change-me

# --- Estado ---
# sqlite (default, zero-infra) ou postgres (recomendado p/ produção/HA).
REGENTE_DB_DRIVER=sqlite
# sqlite: caminho do arquivo | postgres: DSN
REGENTE_DB=/var/lib/regente/regente.db
# Exemplo Postgres (HA + persistência fora do nó):
# REGENTE_DB_DRIVER=postgres
# REGENTE_DB=postgres://user:pw@host:5432/regente?sslmode=require

# Workspace: diretório PERSISTENTE onde vive o clone do repo GitOps. Fica em
# /var/lib/regente de propósito — sobrevive a restart do serviço, reboot da
# máquina e upgrade do binário. Não aponte para /tmp.
REGENTE_WORKSPACE=/var/lib/regente/workspace

# Listen
REGENTE_ADDR=:8080

# --- UI (single-origin) ---
# Serve o SPA buildado na MESMA porta da API/WS (sem CORS). O install-linux.sh
# seta isto sozinho quando encontra a UI buildada (../app/dist ou o bundle de
# release). O front resolve @origin -> window.location.origin em runtime, então
# funciona atrás de qualquer domínio/túnel sem rebuildar. Vazio = só API.
# REGENTE_SPA_DIR=/var/lib/regente/app

# --- GitOps (opcional, mas recomendado) ---
# O repo do workspace é SEU e é DIFERENTE em cada instalação — por isso não há
# default aqui. Crie um repositório VAZIO no GitHub (privado serve) e aponte as
# duas chaves abaixo para ele; no primeiro start o server escreve o conteúdo
# inicial (definitions/, .gitignore, README) e faz o push. Vazio/comentado =
# modo offline: as definitions ficam só no disco desta máquina.
# Atalho: `sudo regente-configure` pergunta isto e escreve aqui.
# REGENTE_GIT_SOURCE=https://github.com/owner/name.git
# REGENTE_GIT_REPO=owner/name
REGENTE_GIT_BRANCH=main

# Token do GitHub p/ push/PR e clone de repo privado. Fine-grained: Contents
# read/write NESSE repo; clássico: escopo `repo`.
# Prefira o secrets provider (não fica na DB em claro) a colar na UI:
# REGENTE_SECRET_GITHUB_TOKEN=ghp_...
# (alternativa equivalente reconhecida pelo server: GITHUB_TOKEN=ghp_...)

# --- HA (opcional, requer Postgres) ---
# Suba N instâncias com o MESMO REGENTE_DB; só o líder roda a daily/dispatch.
# REGENTE_ROLE=all
# REGENTE_SCHEDULER=internal
