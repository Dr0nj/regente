# regente-server configuration (read through the systemd unit's EnvironmentFile).
# Development defaults. Production requires explicit configuration; see
# docs/production-profile.md before exposing the service.
REGENTE_PROFILE=development
# Production conversion (replace the defaults below; do not just uncomment):
# REGENTE_PROFILE=production
# REGENTE_ENVIRONMENT=prod
# REGENTE_NETWORK_BOUNDARY=proxy
# REGENTE_ADDR=127.0.0.1:8080
# REGENTE_APP_URL=https://regente.example.com
# REGENTE_TRUSTED_PROXIES=127.0.0.1/32
# REGENTE_TOKEN=
# REGENTE_SERVER_AGENT=0
# REGENTE_CONTROL_PLANE_EXECUTION=deny
# Empty database: supply REGENTE_BOOTSTRAP_PASSWORD securely for the first boot.

# Legacy development admin token (not a machine credential). REPLACE it with a strong value: it is
# admin-equivalent, it bypasses the login.
REGENTE_TOKEN=change-me

# --- State ---
# sqlite (default, zero infrastructure) or postgres (recommended for production/HA).
REGENTE_DB_DRIVER=sqlite
# sqlite: path to the file | postgres: connection string
REGENTE_DB=/var/lib/regente/regente.db
# Postgres example (HA + state outside the node):
# REGENTE_DB_DRIVER=postgres
# REGENTE_DB=postgres://user:pw@host:5432/regente?sslmode=require

# Workspace: the PERSISTENT directory holding the clone of the GitOps repository.
# It lives under /var/lib/regente on purpose — it survives a service restart, a
# machine reboot and a binary upgrade. Do not point it at /tmp.
REGENTE_WORKSPACE=/var/lib/regente/workspace

# Listen address
REGENTE_ADDR=:8080

# --- UI (single origin) ---
# Serves the built SPA on the SAME port as the API and the WebSocket (no CORS).
# install-linux.sh sets this on its own when it finds a built UI (../app/dist or
# the release bundle). The frontend resolves @origin -> window.location.origin at
# runtime, so it works behind any domain or tunnel without a rebuild.
# Empty = API only.
# REGENTE_SPA_DIR=/var/lib/regente/app

# --- GitOps (optional, but recommended) ---
# The workspace repository is YOURS and is different in every installation — which
# is why there is no default here. Create an EMPTY repository on GitHub (private is
# fine) and point both keys below at it; on the first start the server writes the
# initial content (definitions/, .gitignore, README) and pushes it. Empty or
# commented out = offline mode: the definitions live only on this machine's disk.
# Shortcut: `sudo regente-configure` asks for this and writes it here.
# REGENTE_GIT_SOURCE=https://github.com/owner/name.git
# REGENTE_GIT_REPO=owner/name
REGENTE_GIT_BRANCH=main

# GitHub token for push/PR and for cloning a private repository. Fine-grained:
# Contents read/write ON THAT REPOSITORY; classic: the `repo` scope.
# Prefer the secrets provider (nothing is persisted in the database in plaintext)
# over pasting it into the UI:
# REGENTE_SECRET_GITHUB_TOKEN=ghp_...
# (equivalent alternative the server also recognises: GITHUB_TOKEN=ghp_...)

# --- HA (optional, requires Postgres) ---
# Start N instances against the SAME REGENTE_DB; only the leader runs the daily
# and the dispatch.
# REGENTE_ROLE=all
# REGENTE_SCHEDULER=internal
