[Unit]
Description=Regente independent audit collector
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=regente-audit
Group=regente-audit
WorkingDirectory=/var/lib/regente-audit
ExecStart=/usr/local/bin/regente-server -addr __ADDR__ -audit-collector-file /var/lib/regente-audit/journal.jsonl -audit-collector-public-key /etc/regente-audit/public.key -audit-token-file /etc/regente-audit/token -tls-cert /etc/regente-audit/tls.crt -tls-key /etc/regente-audit/tls.key
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/regente-audit
UMask=0077
[Install]
WantedBy=multi-user.target
