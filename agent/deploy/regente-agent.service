[Unit]
Description=Regente Agent (executor local)
After=network-online.target
Wants=network-online.target

[Service]
# Substitua os placeholders ou use install-linux.sh (faz isso por você).
# O token NÃO vai na ExecStart: linha de comando é legível por qualquer usuário
# via `ps`. O agente lê REGENTE_TOKEN do EnvironmentFile (modo 0600), mesmo
# contrato do install-agent.sh das releases.
EnvironmentFile=/etc/regente/agent.env
ExecStart=/usr/local/bin/regente-agent -server __SERVER__ -id __ID__ -caps __CAPS__
Restart=always
RestartSec=5
# Rode como um usuário sem privilégios (ajuste conforme sua necessidade).
User=__USER__

[Install]
WantedBy=multi-user.target
